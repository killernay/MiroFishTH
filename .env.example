# LLM API configuration (any OpenAI-compatible chat completions endpoint)
# Token usage can be high; try simulations under 40 rounds first
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=your_model_name_here

# ===== Zep memory graph configuration =====
# The monthly free tier is enough for basic use: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Private remote access =====
# The Tailscale IPv4 address on the office host (from: tailscale ip -4).
TAILSCALE_IP=100.64.0.1
# Generate a bcrypt hash with: docker run --rm caddy:2.8.4 caddy hash-password --plaintext 'choose-a-password'
# Escape each $ in the generated hash as $$ so Docker Compose passes it literally.
MIROFISH_PORT=3410
MIROFISH_BASIC_AUTH_USER=mirofish
MIROFISH_BASIC_AUTH_HASH=$$2a$$14$$replace_with_a_bcrypt_hash

# ===== Boost LLM configuration (optional) =====
# If you do not use the boost configuration, omit the following keys from your .env entirely
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
